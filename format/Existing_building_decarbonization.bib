@article{dettorreMappingEnergyFlexibility2019,
  title = {Mapping the Energy Flexibility Potential of Single Buildings Equipped with Optimally-Controlled Heat Pump, Gas Boilers and Thermal Storage},
  author = {D'Ettorre, Francesco and De Rosa, Mattia and Conti, Paolo and Testi, Daniele and Finn, Donal},
